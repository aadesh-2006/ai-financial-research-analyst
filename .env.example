# ===========================================================================
# AI Financial Research Analyst - Environment Configuration Template
# ===========================================================================
# Copy this file to .env and adjust variable values as needed.
# NEVER commit the .env file containing real API keys or passwords.

# ---------------------------------------------------------------------------
# Database Configuration (PostgreSQL)
# ---------------------------------------------------------------------------
POSTGRES_DB=financial_analyst
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_database_password_here
POSTGRES_PORT=5432

# Runtime Database URL for Backend
# (For Docker Compose, 'db' is the host service name on the shared network)
DATABASE_URL=postgresql+psycopg://postgres:your_secure_database_password_here@db:5432/financial_analyst

# ---------------------------------------------------------------------------
# LLM Research Synthesis Configuration (OpenAI)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.2
OPENAI_TIMEOUT=45

# ---------------------------------------------------------------------------
# External Data Ingestion Configuration
# ---------------------------------------------------------------------------
# SEC EDGAR mandates a User-Agent in the format: <App/Company> <Email>
SEC_USER_AGENT=FinancialResearchAnalyst your_email@example.com
SEC_REQUEST_TIMEOUT=15

# Optional: Finnhub API Key for live market news
FINNHUB_API_KEY=

# ---------------------------------------------------------------------------
# Server & Network Ports
# ---------------------------------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=80
UVICORN_WORKERS=2

# CORS allowed origins (comma-separated or JSON array)
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173,http://127.0.0.1

# Optional Frontend Build-time API Base URL (leave empty for same-origin proxy)
VITE_API_BASE_URL=